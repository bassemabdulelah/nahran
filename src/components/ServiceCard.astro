---
import type { Service } from '../data/services';
import type { Lang } from '../config/site';
import { ROUTES } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
const content = service[lang];
const isAr = lang === 'ar';
const href = ROUTES[service.id][lang];
---
<article class="card card--interactive service-card">
  <a class="card-media" href={href} aria-hidden="true" tabindex="-1">
    <img src={service.image} alt="" width="1200" height="750" loading="lazy" decoding="async" />
  </a>
  <div class="card-body">
    <span class="service-icon"><Icon name={service.icon} size={20} /></span>
    <h3 class="card-title"><a href={href}>{content.title}</a></h3>
    <p class="card-text">{content.metaDescription}</p>
    <span class="card-cta">
      {isAr ? 'تفاصيل الخدمة' : 'Service details'}
      <Icon name="arrow" size={16} class="rtl-flip" />
    </span>
  </div>
</article>
