---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactActions from '../components/ContactActions.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { ROUTES, type Lang } from '../config/site';
import { PROJECTS } from '../data/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isAr = lang === 'ar';
const c = PROJECTS[lang];
---
<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDescription} routeId="projects">
  <Breadcrumbs
    lang={lang}
    items={[{ label: isAr ? 'الرئيسية' : 'Home', href: ROUTES.home[lang] }, { label: c.h1 }]}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="stack" style="max-width:820px">
        <span class="eyebrow">{isAr ? 'أعمالنا' : 'Our work'}</span>
        <h1>{c.h1}</h1>
        {c.intro.map((p) => <p class="lede">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice" role="note">
        <Icon name="layers" size={20} />
        <div>
          <strong>{c.notice.heading}</strong>
          <p>{c.notice.body}</p>
        </div>
      </div>

      <div class="grid grid--3" style="margin-top:2rem">
        {c.categories.map((cat, i) => (
          <figure class="card project-card" data-reveal data-reveal-delay={String((i % 3) * 0.05)}>
            <img src="/images/placeholder-project.svg" alt={isAr ? `مساحة مخصّصة لصورة عمل حقيقي ضمن ${cat}` : `Reserved space for a real project photo in ${cat}`} width="800" height="500" loading="lazy" decoding="async" />
            <figcaption>
              <strong>{cat}</strong>
              <span>{isAr ? 'بانتظار الصورة الحقيقية' : 'Awaiting a real photo'}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="cta-band" style="margin-top:2.4rem" data-reveal>
        <div>
          <h2>{isAr ? 'هل تريد تشابهًا لما رأيت؟' : 'Want something similar?'}</h2>
          <p>{isAr
            ? 'أرسل لنا الطول والعرض وصور المكان، وسنوضّح ما يمكن تنفيذه.'
            : 'Send us the size and photos of your space and we will explain what can be done.'}</p>
        </div>
        <ContactActions lang={lang} />
      </div>

      <p class="muted" style="margin-top:1.4rem; display:flex; gap:0.5rem; align-items:center">
        <Icon name="ruler" size={17} />
        <span>{isAr ? 'لم يظهر نوع عملك؟ أخبرنا وسنوضّح.' : 'Do not see your type of work? Ask us and we will explain.'}</span>
      </p>
    </div>
  </section>

  <FaqList items={c.faqs} lang={lang} schema={true} heading={isAr ? 'أسئلة عن الأعمال' : 'Questions about our work'} />
</BaseLayout>
