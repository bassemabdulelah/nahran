---
import type { Faq } from '../data/services';
import type { Lang } from '../config/site';

interface Props {
  items: Faq[];
  lang: Lang;
  heading?: string;
  /** Emit FAQPage structured data. Only used when content truly is an FAQ. */
  schema?: boolean;
  id?: string;
}

const { items, lang, heading, schema = false, id = 'faq' } = Astro.props;
const isAr = lang === 'ar';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section class="section section--soft" aria-labelledby={id}>
  <div class="container">
    <div class="section-head section-head--center">
      <h2 id={id}>{heading ?? (isAr ? 'أسئلة شائعة' : 'Frequently asked questions')}</h2>
    </div>
    <div class="faq">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
